#!/usr/bin/env bash
# shellcheck shell=bash
# ==============================================================================
# chrony (NTP peering) - render chrony.conf and the key file from add-on options
# Usage: chrony-render-config <options.json> <chrony.conf> <keyfile>
# Pure bash + jq so it can be tested without Supervisor/bashio.
# Warnings go to stderr. Secrets are written only to <keyfile> (mode 0600).
# ==============================================================================
set -euo pipefail

OPTIONS="${1:?options.json}"
CONF="${2:?chrony.conf}"
KEYFILE="${3:?keyfile}"
trap 'rm -f "${CONF}.tmp"' EXIT

warn() { echo "WARNING: $*" >&2; }
die() { echo "ERROR: $*" >&2; exit 1; }
opt() { jq -r "$1 // empty" "${OPTIONS}"; }

# Render one source line. $1 = directive (server|pool|peer), $2 = JSON object
render_source() {
  local directive="$1" json="$2" addr line key minpoll maxpoll
  addr=$(jq -r '.address // empty' <<<"${json}")
  [[ -n "${addr}" ]] || die "${directive} entry without address"
  [[ "${addr}" =~ ^[A-Za-z0-9._:-]+$ ]] || die "invalid ${directive} address: ${addr}"
  line="${directive} ${addr}"
  key=$(jq -r '.key // empty' <<<"${json}")
  if [[ -n "${key}" ]]; then
    [[ "${key}" =~ ^[0-9]+$ ]] || die "key id for ${addr} must be a number"
    jq -e --argjson k "${key}" '[.keys[]?.id] | index($k)' "${OPTIONS}" >/dev/null \
      || warn "${directive} ${addr} uses key ${key}, but no key with id ${key} is defined in 'keys'"
    line+=" key ${key}"
  fi
  [[ "$(jq -r '.xleave // false' <<<"${json}")" == "true" ]] && line+=" xleave"
  minpoll=$(jq -r --arg d "$(opt .default_minpoll)" '.minpoll // ($d|select(.!=""))  // empty' <<<"${json}")
  maxpoll=$(jq -r --arg d "$(opt .default_maxpoll)" '.maxpoll // ($d|select(.!="")) // empty' <<<"${json}")
  [[ -n "${minpoll}" ]] && line+=" minpoll ${minpoll}"
  [[ -n "${maxpoll}" ]] && line+=" maxpoll ${maxpoll}"
  if [[ "$(jq -r '.iburst // false' <<<"${json}")" == "true" ]]; then
    if [[ "${directive}" == "peer" ]]; then
      warn "peer ${addr}: chrony does not support iburst on peer lines; ignoring it"
    else
      line+=" iburst"
    fi
  fi
  if jq -e '.prefer == true' <<<"${json}" >/dev/null; then line+=" prefer"; fi
  echo "${line}"
}

mode=$(opt .mode); mode="${mode:-pool}"
legacy_iburst=" iburst"

{
  echo "# Generated by the chrony (NTP peering) add-on. Do not edit; change the add-on options."
  echo "driftfile /data/chrony/drift"
  echo "makestep $(opt .makestep_threshold | sed 's/^$/0.1/') $(opt .makestep_limit | sed 's/^$/-1/')"
  echo

  echo "# Upstream sources (mode: ${mode})"
  if [[ "${mode}" == "pool" ]]; then
    pool=$(opt .ntp_pool)
    [[ -n "${pool}" ]] && echo "pool ${pool}${legacy_iburst}"
  elif [[ "${mode}" == "server" ]]; then
    while IFS= read -r s; do
      [[ -n "${s}" ]] && echo "server ${s}${legacy_iburst}"
    done < <(jq -r '.ntp_server[]? // empty' "${OPTIONS}")
  fi
  # mode "none" = only peers/servers/refclocks below

  echo
  echo "# Extra servers"
  while IFS= read -r j; do
    [[ -n "${j}" ]] && render_source server "${j}"
  done < <(jq -c '.servers[]?' "${OPTIONS}")

  echo
  echo "# Symmetric peers"
  while IFS= read -r j; do
    [[ -n "${j}" ]] && render_source peer "${j}"
  done < <(jq -c '.peers[]?' "${OPTIONS}")

  echo
  echo "# Reference clocks"
  while IFS= read -r r; do
    [[ -n "${r}" ]] && echo "refclock ${r}"
  done < <(jq -r '.refclocks[]? // empty' "${OPTIONS}")

  echo
  echo "# Clients allowed to use this NTP server"
  n_allow=$(jq '[.allow[]?] | length' "${OPTIONS}")
  if [[ "${n_allow}" == "0" ]]; then
    echo "allow all"
  else
    while IFS= read -r a; do
      [[ -z "${a}" ]] && continue
      [[ "${a}" =~ ^[A-Za-z0-9./:-]+$ ]] || die "invalid allow entry: ${a}"
      echo "allow ${a}"
    done < <(jq -r '.allow[]?' "${OPTIONS}")
  fi

  if [[ "$(opt .local_stratum)" != "" ]]; then
    echo
    echo "local stratum $(opt .local_stratum)"
  fi
} > "${CONF}.tmp"
mv "${CONF}.tmp" "${CONF}"

# Key file
umask 077
: > "${KEYFILE}"
chmod 0600 "${KEYFILE}"
n_keys=$(jq '[.keys[]?] | length' "${OPTIONS}")
if [[ "${n_keys}" -gt 0 ]]; then
  while IFS= read -r k; do
    id=$(jq -r '.id' <<<"${k}")
    type=$(jq -r '.type // "SHA1"' <<<"${k}")
    [[ "${id}" =~ ^[0-9]+$ && "${id}" -ge 1 ]] || die "key id must be a positive integer"
    [[ "${type}" =~ ^(MD5|SHA1|SHA256|SHA384|SHA512|SHA3-224|SHA3-256|SHA3-384|SHA3-512|TIGER|WHIRLPOOL|AES128|AES256)$ ]] \
      || die "key ${id}: unsupported type ${type}"
    secret=$(jq -r '.secret // empty' <<<"${k}")
    [[ -n "${secret}" ]] || die "key ${id}: secret is empty"
    [[ "${secret}" =~ [[:space:]] ]] && die "key ${id}: secret must not contain whitespace (use HEX:...)"
    if [[ "${type}" == AES* && "${secret}" != HEX:* ]]; then
      warn "key ${id}: AES keys must be HEX: encoded (AES128 = 32 hex digits, AES256 = 64)"
    fi
    printf '%s %s %s\n' "${id}" "${type}" "${secret}" >> "${KEYFILE}"
  done < <(jq -c '.keys[]' "${OPTIONS}")
  echo -e "\n# Authentication keys (contents not logged)\nkeyfile ${KEYFILE}" >> "${CONF}"
fi

extra=$(opt .extra_config)
if [[ -n "${extra}" ]]; then
  printf '\n# extra_config\n%s\n' "${extra}" >> "${CONF}"
fi
