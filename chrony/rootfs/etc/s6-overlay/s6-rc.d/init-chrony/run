#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Chrony (NTP peering) - fork of the Home Assistant Community App: chrony
# Configures chrony
# Modified for the chrony (NTP peering) fork: options are rendered by
# /usr/bin/chrony-render-config (servers, peers, keys, allow, refclocks).
# ==============================================================================
readonly CHRONY_CONF='/etc/chrony/chrony.conf'
readonly CHRONY_KEYS='/etc/chrony/chrony.keys'

# Check running mode
if bashio::config.equals 'mode' 'pool' \
    && bashio::config.is_empty 'ntp_pool';
then
    bashio::log.fatal 'pool mode is configured but the ntp_pool is empty'
    bashio::exit.nok
fi

if bashio::config.equals 'mode' 'server' \
    && bashio::config.is_empty 'ntp_server';
then
    bashio::log.fatal 'server mode is configured but the ntp_server is empty'
    bashio::exit.nok
fi

if bashio::config.equals 'mode' 'none' \
    && bashio::config.is_empty 'peers' \
    && bashio::config.is_empty 'servers' \
    && bashio::config.is_empty 'refclocks';
then
    bashio::log.fatal 'mode is "none" but no peers, servers or refclocks are set'
    bashio::exit.nok
fi

# Persistent drift file; chronyd may drop root privileges to the chrony user
mkdir -p /data/chrony
if getent passwd chrony > /dev/null; then
    chown chrony:chrony /data/chrony
fi

if ! chrony-render-config /data/options.json "${CHRONY_CONF}" "${CHRONY_KEYS}"; then
    bashio::exit.nok 'Could not render the chrony configuration'
fi

# The key file is never printed; chrony.conf only references its path.
bashio::log.info "Rendered ${CHRONY_CONF}:"
while IFS= read -r line; do
    bashio::log.info "  ${line}"
done < "${CHRONY_CONF}"

if ! chronyd -p -f "${CHRONY_CONF}" > /dev/null; then
    bashio::exit.nok 'chronyd rejected the rendered configuration'
fi
